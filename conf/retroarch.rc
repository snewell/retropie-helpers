# ==============================================================================
# ~/.rph.d/retroarch.rc
# Global configuration profile matrix for the retropie-helpers environment.
# ==============================================================================

# Common things like our root save folder and scratch dir
[ -e ~/.rph.d/common.rc ] && source ~/.rph.d/common.rc

# -----------------------------------------------------------------------------
# DEFAULT PIPELINE ASSIGNMENTS
# -----------------------------------------------------------------------------
# Dynamically point the savepath-injector to your system target folder
spi_args+=(
    --root-save-dir "${ROOT_SAVE_PATH}"
)

# Configure your xdelta patching volatile RAM target workspace
xdp_args+=(
    --scratch "${GLOBAL_SCRATCH_PAD}"
)

# -----------------------------------------------------------------------------
# POWER-USER RECIPIES & CONDITIONAL OVERRIDES
# You have full access to native Bash logic. Use the explicit runtime parameters
# populated by the launcher ($SYSTEM, $EMULATOR_ID, $ROM) to handle custom behaviors.
# -----------------------------------------------------------------------------

# --- Example 1: Isolating a Specific Core ---
# If a specific core behaves unexpectedly with on-the-fly patching, you can
# explicitly drop the feature for just that target environment:
#
# if [ "${EMULATOR_ID}" == "lr-ppsspp" ]; then
#     orch_args+=(--xdelta-patcher=disable)
# fi


# --- Example 2: Dynamic Multiplayer/Shared Save Redirects ---
# You can override paths conditionally based on the game name, making it simple
# to sync co-op memory cards or separate playthrough states:
#
# if [[ "${ROM}" == *"Final Fantasy VII"* ]]; then
#     spi_args=(--root-save-dir "${ROOT_SAVE_PATH}/coop-saves")
# fi


# --- Example 3: Emergency Pipeline Escape Hatch ---
# If an upstream update alters an emulator's CLI layout, you can engage the
# Break-Glass safety rule to bypass automation and execute a raw array string:
#
# if [[ "${ROM}" == *"Extreme-Edge-Case-Game"* ]]; then
#     ORCHESTRATOR_BREAK_GLASS="true"
#     EMULATOR_OVERRIDE_CMD=(
#         rph unique-memcard --save-dir "${ROOT_SAVE_PATH}/custom" --
#         /usr/bin/custom-emu --flags "${ROM}"
#     )
# fi
