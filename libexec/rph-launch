#!/bin/bash
# libexec/rph-wrapper.sh (Explicit Argument Passing Edition)
set -euo pipefail

INFO_FILE=/dev/shm/runcommand.info
LIBEXEC_DIR="$(dirname "${0}")"

RPH_EMULATOR_ID="${1}"
TARGET_LAUNCHER="rph-launch-${RPH_EMULATOR_ID}"
shift

if [ "${1}" = "--help" ]; then
    exec "${LIBEXEC_DIR}/${TARGET_LAUNCHER}" --help
fi

dry_run=""
if [ "${1}" = "--dry-run" ]; then
    dry_run="--dry-run"
    shift
fi

# 1. Gather telemetry data at the absolute front gate
if [ -e "${INFO_FILE}" ]; then
    SYSTEM=$(sed '1q;d' "${INFO_FILE}")
    EMULATOR_ID=$(sed '2q;d' "${INFO_FILE}")
    ROM=$(sed '3q;d' "${INFO_FILE}")
else
    echo "Failed to gather information about running rom" >&2
    # TODO: try to figure it out via CLI
    exit 1
fi
EMULATOR_ID="${EMULATOR_ID:-unknown}"

# 2. Match local data profile configuration shards
DATA_PROFILE="${LIBEXEC_DIR}/../share/rph-pipeline-data/${RPH_EMULATOR_ID}.data"
if [ -f "${DATA_PROFILE}" ]; then
    source "${DATA_PROFILE}"
else
    echo "No data file available for ${TARGET_LAUNCHER} (expected ${DATA_PROFILE})" >&2
    exit 1
fi

ORCHESTRATOR_BREAK_GLASS="false"
ORCHESTRATOR_DEBUG=""
declare -a EMULATOR_OVERRIDE_CMD=()

# 3. Parse customizable .rc layout scripts
if [ -f "${RC_FILE}" ]; then
    source "${RC_FILE}"
fi

# 4. Break-Glass Emergency Overrides
if [ "${ORCHESTRATOR_BREAK_GLASS}" = "true" ]; then
    if [ ${#EMULATOR_OVERRIDE_CMD[@]} -eq 0 ]; then
        echo "Error: ORCHESTRATOR_BREAK_GLASS is true but EMULATOR_OVERRIDE_CMD is empty!" >&2
        exit 1
    fi
    exec "${EMULATOR_OVERRIDE_CMD[@]}"
fi

# 5. Build dynamic orchestration array payload block
orch_payload=(
    "${orch_args[@]}"
    ${dry_run} # not quoted on purpose--empty value means no argument, but quotes would an empty string
)

# the exclamation point here gets us the key names, so that's what the loop is iterating over
for array_name in "${!tool_map[@]}"; do
    target_flag="${tool_map[${array_name}]}"
    indirect_reference="${array_name}[@]"
    # the exclamation mark here runs the indirect reference into a direct reference, so we're duplicating the array set in rc files
    array_values=("${!indirect_reference}")
    # and now we can iterate over the contents of the array, which are the actual arguments to the tool
    if [ ${#array_values[@]} -gt 0 ]; then
        for item in "${array_values[@]}"; do
            orch_payload+=("${target_flag}=${item}")
        done
    fi
done

# -----------------------------------------------------------------------------
# THE DETERMINISTIC EXTRACTION IMPROVEMENT:
# We feed --rom and --system as explicit, core switches directly to the launcher.
# -----------------------------------------------------------------------------
exec "${LIBEXEC_DIR}/${TARGET_LAUNCHER}" \
    --rom "${ROM}" \
    --system "${SYSTEM}" \
    "${orch_payload[@]}" \
    -- "${@}"
