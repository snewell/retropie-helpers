#!/usr/bin/python3

import argparse
import os.path
import shutil
import subprocess

import rph_files


def _verify_no_cards(memcards):
    for mcd in memcards:
        if os.path.exists(mcd):
            raise RuntimeError(f"Memory card already exists: {mcd}")


def main():
    parser = argparse.ArgumentParser(
        prog="unique-memcard",
        description="Provide a unique memory card file for each PCSX2 title",
    )
    parser.add_argument(
        "-r",
        "--rom",
        help="rom being executed",
    )
    parser.add_argument(
        "-m",
        "--memcard-path",
        help="Explicit path to emulator's memory card",
        required=True,
    )
    parser.add_argument(
        "-c",
        "--card-name",
        help="Base name for the persistent memory card",
    )
    parser.add_argument(
        "-s",
        "--save-dir",
        help="Path for per-game memory cards (defaults to content directory)",
    )
    parser.add_argument(
        "-e",
        "--srm-extension",
        help="Extension for the per-game memory card",
        default="ps2",
    )
    parser.add_argument(
        "args",
        nargs="*",
    )
    args = parser.parse_args()
    args.rom, args.args = rph_files.get_filename_and_args(args.rom, args.args)
    rom_dir = os.path.dirname(args.rom)
    if args.save_dir is None:
        args.save_dir = rom_dir
    if args.card_name is None:
        base, _ = os.path.splitext(os.path.basename(args.rom))
        args.card_name = base

    memcards = [
        args.memcard_path,
    ]
    _verify_no_cards(memcards)
    save_file = os.path.join(args.save_dir, f"{args.card_name}.{args.srm_extension}")

    print(f"save_file={save_file}")
    print(f"mp={args.memcard_path}")
    if os.path.isfile(save_file):
        shutil.copy2(save_file, args.memcard_path)

    try:
        # everything is set up, execute
        subprocess.run(args.args, check=True)
    finally:
        # copy files back
        if os.path.isfile(args.memcard_path):
            if os.path.isfile(save_file):
                # only copy if the new file is newer
                if os.path.getmtime(save_file) < os.path.getmtime(args.memcard_path):
                    shutil.copy2(args.memcard_path, save_file)
            else:
                # old file doesn't exist, so copy the new one back unconditioally
                shutil.copy2(args.memcard_path, save_file)

        for m in memcards:
            if os.path.isfile(m):
                os.remove(m)


if __name__ == "__main__":
    main()
