#!/usr/bin/python3

import argparse
import os
import os.path
import shutil
import subprocess

import rph_cli
import rph_patch


def _make_xdelta_patcher(work_dir):
    def _do_xdelta(original):
        base = os.path.basename(original)
        romdir = os.path.dirname(original)
        out_file = os.path.join(work_dir, base)
        no_ext, _ = os.path.splitext(base)
        patch = os.path.join(f"{romdir}", f"{no_ext}.xdelta")
        subprocess.run(
            [
                "xdelta3",
                "-d",
                "-s",
                original,
                patch,
                out_file,
            ],
            check=True,
        )

    return _do_xdelta


def _main():
    parser = argparse.ArgumentParser(
        prog="xdelta-patcher",
        description="Apply available xdelta patches before launching emulator",
    )
    rph_cli.add_rom_argument(parser)
    rph_cli.add_workdir_argument(parser)
    rph_cli.add_trailing_arguments(parser)

    args = parser.parse_args()
    args.work_dir = os.path.join(args.work_dir, str(os.getpid()))
    pi = rph_patch.build_patch_info(args.rom, "xdelta")
    try:
        if pi.files_to_patch:
            os.makedirs(args.work_dir, exist_ok=True)
            rph_patch.do_patch_work(
                pi, args.work_dir, _make_xdelta_patcher(args.work_dir)
            )
            target = os.path.join(args.work_dir, os.path.basename(args.rom))
            rph_cli.replace_or_append_arg(args.args, args.rom, target)

        # everything is patched, execute
        subprocess.run(args.args, check=True)

    finally:
        if os.path.exists(args.work_dir):
            shutil.rmtree(args.work_dir)


if __name__ == "__main__":
    _main()
