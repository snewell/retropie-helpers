#!/usr/bin/python3

import argparse
import glob
import os
import os.path
import shutil
import subprocess

import rph_files
import rph_patch

_DEFAULT_SCRATCH = "/dev/shm"


def _make_xdelta_patcher(work_dir):
    def _do_xdelta(original):
        base = os.path.basename(original)
        romdir = os.path.dirname(original)
        out_file = os.path.join(work_dir, base)
        no_ext, ext = os.path.splitext(base)
        patch = os.path.join(f"{romdir}", f"{no_ext}.xdelta")
        subprocess.run(
            [
                "xdelta3",
                "-d",
                "-s",
                original,
                patch,
                out_file,
            ],
            check=True,
        )

    return _do_xdelta


def _main():
    parser = argparse.ArgumentParser(
        prog="xdelta-patcher",
        description="Apply available xdelta patches before launching emulator",
    )
    parser.add_argument(
        "-p",
        "--preserve",
        action="store_true",
        help="Don't clean scratch directory",
    )
    parser.add_argument("-w", "--work-dir", help="Directory to use for temporary files")
    parser.add_argument(
        "-S",
        "--symlinks",
        help="Create symlinks to related files (i.e., memory cards)",
        action="store_true",
    )
    parser.add_argument(
        "-r",
        "--rom",
        help="rom to patch",
        required=True,
    )
    parser.add_argument(
        "args",
        nargs="*",
    )

    args = parser.parse_args()
    if args.work_dir is None:
        args.work_dir = _DEFAULT_SCRATCH
    args.work_dir = os.path.join(args.work_dir, str(os.getpid()))
    pi = rph_patch.build_patch_info(args.rom, "xdelta")
    try:
        if pi.files_to_patch:
            os.makedirs(args.work_dir, exist_ok=True)
            rph_patch.do_patch_work(
                pi, args.work_dir, _make_xdelta_patcher(args.work_dir)
            )
            target = os.path.join(args.work_dir, os.path.basename(args.rom))
            replaced = False
            for i in range(len(args.args)):
                if args.args[i] == args.rom:
                    args.args[i] = target
                    replaced = True
            if not replaced:
                args.args.append(target)

        # everything is patched, execute
        subprocess.run(args.args, check=True)

    finally:
        if os.path.exists(args.work_dir):
            shutil.rmtree(args.work_dir)


if __name__ == "__main__":
    _main()
