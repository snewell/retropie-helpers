#!/usr/bin/python3
# File location: libexec/rph-launch-pcsx2
from orchestrator import EmulatorOrchestrator
import sys

def pcsx2_cli_mutator(emulator_args, override_args):
    """
    Knows the domain-specific layout quirks of PCSX2 arguments.
    Safely strips conflicting flags and replaces them with user overrides.
    """
    # 1. Look for custom GUI/Window overrides inside our override_args array
    if "--no-fullscreen" in override_args:
        # Strip out the default '-fullscreen' flag passed by the core wrapper script
        if "-fullscreen" in emulator_args:
            emulator_args.remove("-fullscreen")

    # 2. Append the new overrides seamlessly to the payload array
    for arg in override_args:
        if arg not in emulator_args:
            emulator_args.append(arg)

    return emulator_args


def main():
    # We pass the custom mutator function straight into the execution engine
    (
        EmulatorOrchestrator("rph-launch-pcsx2",  "pcsx2 orchestration pipeline")
            .add_feature("unique_memcard")
            .add_feature("xdelta_patcher")
            .parse_and_execute(custom_mutator_fn=pcsx2_cli_mutator)
    )

if __name__ == "__main__":
    main()
