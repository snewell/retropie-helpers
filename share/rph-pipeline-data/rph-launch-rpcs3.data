# File location: libexec/rph-launch-dolphin.data
# Explicitly separates your emulator profile targets
RC_FILE=~/.rph.d/dolphin.rc

# Register ONLY the variable key matrices valid for a dolphin pipeline
declare -A tool_map
tool_map[xdp_args]="--xdelta-patcher-arg"
tool_map[dolphin_args]="--emu-arg"

# Declare the variables so the .rc script can populate them natively
umc_args=()
dolphin_args=()
orch_args=()
